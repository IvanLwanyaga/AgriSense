{
  "name": "agrisense-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "admin:bootstrap": "npm run build && node lib/bootstrapAdmin.js",
