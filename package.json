{
  "name": "agri-intelligence",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node -e \"require('node:fs').mkdirSync('.firebase/emulator-data', { recursive: true })\"",
    "dev": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,storage,functions --project demo-agrisense-local --import=.firebase/emulator-data --export-on-exit=.firebase/emulator-data \"vite\"",
    "compose:up": "node scripts/docker-compose.mjs up --build",
    "dev:cloud": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.3",
    "@types/google.maps": "^3.66.10",
    "@types/qrcode": "^1.5.6",
    "firebase": "^12.18.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.5"
  }
}
